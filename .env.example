# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ─── Databases ───────────────────────────────────────────────────────────────
# Three logically separated stores. In production these are SEPARATE database
# servers with separate credentials. SQLite files here for zero-setup demo.
HR_DATABASE_URL="file:../../hr.db"
HEALTH_DATABASE_URL="file:../../health.db"

# ─── Auth ────────────────────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION. Generate: openssl rand -hex 32
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ─── Scheduling engine ───────────────────────────────────────────────────────
SOLVER_URL=http://localhost:8000
SOLVER_TIMEOUT_MS=30000
# If the Python CP-SAT service is unreachable, fall back to the built-in
# TypeScript heuristic solver so a demo never dies. Set false to fail loudly.
SOLVER_FALLBACK_ENABLED=true

# ─── Privacy / firewall ──────────────────────────────────────────────────────
# Hard kill-switch: if true, the firewall refuses to emit any constraint whose
# payload fails the diagnosis-free schema check. Never set to false.
FIREWALL_STRICT_MODE=true
# Minimum group size before any aggregate statistic is shown (k-anonymity).
FAIRNESS_MIN_GROUP_SIZE=5

# ─── Fatigue engine ──────────────────────────────────────────────────────────
FATIGUE_CEILING=80
FATIGUE_WARN_THRESHOLD=65

# ─── Encryption at rest for the health store ─────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
